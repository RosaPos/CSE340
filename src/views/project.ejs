<%- include('partials/header') %>

  <main>
    <h1>
      <%= project.title %>
    </h1>

    <p>
      <%= project.description %>
    </p>

    <p>
      <strong>Organization:</strong>
      <a href="/organization/<%= project.organization_id %>">
        <%= project.organization_name %>
      </a>
    </p>

    <p>
      <strong>Location:</strong>
      <%= project.location %>
    </p>

    <p>
      <strong>Date:</strong>
      <%= project.date.toDateString() %>
    </p>

    <% if (user && user.role_name==='admin' ) { %>
      <p>
        <a href="/edit-project/<%= project.project_id %>">
          Edit Project
        </a>
      </p>
      <% } %>

        <h2>Categories</h2>

        <% if (categories.length===0) { %>
          <p>No categories are assigned to this project.</p>
          <% } else { %>
            <div class="category-tags">
              <% categories.forEach(category=> { %>
                <a class="category-tag" href="/category/<%= category.category_id %>">
                  <%= category.name %>
                </a>
                <% }); %>
            </div>
            <% } %>

              <% if (user && user.role_name==='admin' ) { %>
                <p>
                  <a href="/assign-categories/<%= project.project_id %>">
                    Edit Categories
                  </a>
                </p>
                <% } %>

  </main>

  <%- include('partials/footer') %>