<%- include('partials/header') %>

<main>
  <h1><%= category.name %></h1>

  <h2>Service Projects</h2>

  <% if (projects.length === 0) { %>
    <p>There are no service projects for this category.</p>
  <% } else { %>
    <ul>
      <% projects.forEach(project => { %>
        <li>
          <a href="/project/<%= project.project_id %>">
            <%= project.title %>
          </a>
        </li>
      <% }); %>
    </ul>
  <% } %>
</main>

<%- include('partials/footer') %>