<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Dashboard</h2>

        <p>
            Name: <%= name %>
        </p>

        <p>
            Username: <%= email %>
        </p>

        <!-- W06 - My Volunteer Projects -->
        <section class="volunteer-dashboard">
            <h2>My Volunteer Projects</h2>

            <% if (volunteerProjects.length===0) { %>
                <p>
                    You have not volunteered for any projects yet.
                </p>

                <p>
                    <a href="/projects">Browse Service Projects</a>
                </p>

                <% } else { %>
                    <ul class="volunteer-project-list">
                        <% volunteerProjects.forEach(project=> { %>
                            <li class="volunteer-project-item">

                                <h3>
                                    <a href="/project/<%= project.project_id %>">
                                        <%= project.title %>
                                    </a>
                                </h3>

                                <p>
                                    <strong>Location:</strong>
                                    <%= project.location %>
                                </p>

                                <p>
                                    <strong>Date:</strong>
                                    <%= project.date.toDateString() %>
                                </p>

                                <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                                    <input type="hidden" name="returnTo" value="dashboard">

                                    <button type="submit">
                                        Remove Volunteering
                                    </button>
                                </form>

                            </li>
                            <% }); %>
                    </ul>
                    <% } %>
        </section>

        <% if (user && user.role_name==='admin' ) { %>
            <section aria-label="Administration">
                <h2>Administration</h2>

                <p>
                    <a href="/users">View Registered Users</a>
                </p>
            </section>
            <% } %>

    </main>

    <%- include('partials/footer') %>